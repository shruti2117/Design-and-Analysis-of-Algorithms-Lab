#include <stdio.h>
int max(int a, int b) {
    return (a > b) ? a : b;
}
int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    int values[n];
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
	}
    int weights[n];
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
	}
    int W;
    if (scanf("%d", &W) != 1) return 0;
    int dp[W + 1];
    for (int j = 0; j <= W; j++) {
        dp[j] = 0;
	}
    for (int i = 0; i < n; i++) {
        for (int j = W; j >= weights[i]; j--) {
            dp[j] = max(dp[j], dp[j - weights[i]] + values[i]);
        }
	}
    printf("%d\n", dp[W]);
    return 0;
}

